{
  "name": "personal-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "blog:new": "node scripts/create-blog-post.mjs",
    "blog:preview": "vite --mode editorial",
    "blog:publish": "node scripts/publish-blog-post.mjs",
    "blog:validate": "node scripts/validate-editorial.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate:data": "node scripts/validate-data.mjs",
    "lint": "node scripts/lint-basic.mjs",
    "format:check": "node scripts/format-check.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:blog": "node scripts/blog-browser-test.mjs",
    "check": "npm run validate:data && npm run lint && npm run format:check && npm run test:smoke && npm test"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.14",
    "@mui/material": "^5.15.14",
    "gsap": "^3.15.0",
    "i18next": "^26.3.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@babel/parser": "7.29.2",
    "@vitejs/plugin-react": "^4.2.1",
    "playwright": "1.65.1",
    "vite": "6.4.6"
  }
}
